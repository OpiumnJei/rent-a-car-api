<?xml version="1.0" encoding="UTF-8"?>
<!-- Plantilla de factura Rent a car Sys (RF-06.3). Por que del redisenio: encabezado con
     identidad comercial, bloque de datos (cliente/vehiculo/contrato/periodo), tabla con
     cabecera en color y filas alternadas, y caja de totales; la inicial se titula FACTURA
     y la complementaria FACTURA COMPLEMENTARIA con referencia a la inicial. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="factura" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
  <parameter name="empresaNombre" class="java.lang.String"><defaultValueExpression><![CDATA["Rent a car Sys"]]></defaultValueExpression></parameter>
  <parameter name="empresaRnc" class="java.lang.String"><defaultValueExpression><![CDATA["RNC: 000-00000-0"]]></defaultValueExpression></parameter>
  <parameter name="empresaDireccion" class="java.lang.String"><defaultValueExpression><![CDATA["Av. Principal #123, Santo Domingo, R.D."]]></defaultValueExpression></parameter>
  <parameter name="empresaTelefono" class="java.lang.String"><defaultValueExpression><![CDATA["Tel.: (809) 000-0000"]]></defaultValueExpression></parameter>
  <parameter name="facturaId" class="java.lang.Long"/>
  <parameter name="tipo" class="java.lang.String"><defaultValueExpression><![CDATA["INICIAL"]]></defaultValueExpression></parameter>
  <parameter name="facturaOrigenId" class="java.lang.Long"/>
  <parameter name="contratoId" class="java.lang.Long"/>
  <parameter name="fechaEmision" class="java.lang.String"/>
  <parameter name="clienteNombre" class="java.lang.String"/>
  <parameter name="clienteDocumento" class="java.lang.String"/>
  <parameter name="vehiculoPlaca" class="java.lang.String"/>
  <parameter name="vehiculoDescripcion" class="java.lang.String"/>
  <parameter name="periodo" class="java.lang.String"/>
  <parameter name="subtotal" class="java.math.BigDecimal"/>
  <parameter name="cargos" class="java.math.BigDecimal"/>
  <parameter name="impuestos" class="java.math.BigDecimal"/>
  <parameter name="total" class="java.math.BigDecimal"/>
  <field name="concepto" class="java.lang.String"/>
  <field name="cantidad" class="java.math.BigDecimal"/>
  <field name="precioUnitario" class="java.math.BigDecimal"/>
  <field name="subtotal" class="java.math.BigDecimal"/>
  <title>
    <band height="248">
      <staticText><reportElement x="0" y="0" width="350" height="26"/><textElement><font fontName="SansSerif" size="20" isBold="true"/></textElement><text><![CDATA[Rent a car Sys]]></text></staticText>
      <textField><reportElement x="0" y="28" width="350" height="14"/><textElement><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$P{empresaRnc}]]></textFieldExpression></textField>
      <textField><reportElement x="0" y="42" width="350" height="14"/><textElement><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$P{empresaDireccion}]]></textFieldExpression></textField>
      <textField><reportElement x="0" y="56" width="350" height="14"/><textElement><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$P{empresaTelefono}]]></textFieldExpression></textField>
      <frame>
        <reportElement x="368" y="0" width="187" height="86"/>
        <box><pen lineWidth="1.0" lineColor="#1F3864"/><topPen lineWidth="3.0" lineColor="#1F3864"/></box>
        <textField>
          <reportElement x="5" y="6" width="177" height="22">
            <printWhenExpression><![CDATA[new Boolean(!$P{tipo}.equals("COMPLEMENTARIA"))]]></printWhenExpression>
          </reportElement>
          <textElement textAlignment="Center"><font fontName="SansSerif" size="14" isBold="true"/></textElement>
          <textFieldExpression><![CDATA["FACTURA"]]></textFieldExpression>
        </textField>
        <textField>
          <reportElement x="5" y="4" width="177" height="24">
            <printWhenExpression><![CDATA[new Boolean($P{tipo}.equals("COMPLEMENTARIA"))]]></printWhenExpression>
          </reportElement>
          <textElement textAlignment="Center"><font fontName="SansSerif" size="12" isBold="true"/></textElement>
          <textFieldExpression><![CDATA["FACTURA COMPLEMENTARIA"]]></textFieldExpression>
        </textField>
        <textField><reportElement x="5" y="30" width="177" height="20"/><textElement textAlignment="Center"><font fontName="SansSerif" size="12" isBold="true"/></textElement><textFieldExpression><![CDATA["No. " + $P{facturaId}]]></textFieldExpression></textField>
        <textField><reportElement x="5" y="52" width="177" height="16"/><textElement textAlignment="Center"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["Emitida: " + $P{fechaEmision}]]></textFieldExpression></textField>
      </frame>
      <textField>
        <reportElement x="0" y="94" width="555" height="16">
          <printWhenExpression><![CDATA[new Boolean($P{tipo}.equals("COMPLEMENTARIA"))]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Center" markup="none"><font fontName="SansSerif" size="10" isBold="true" isItalic="true"/></textElement>
        <textFieldExpression><![CDATA["Cargos de devolucion — Ref. factura inicial No. " + $P{facturaOrigenId}]]></textFieldExpression>
      </textField>
      <frame>
        <reportElement x="0" y="116" width="555" height="118"/>
        <box><pen lineWidth="0.75" lineColor="#BFBFBF"/><topPen lineWidth="2.0" lineColor="#1F3864"/></box>
        <staticText><reportElement x="10" y="6" width="200" height="13"/><textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[CLIENTE]]></text></staticText>
        <textField><reportElement x="10" y="20" width="260" height="16"/><textElement><font fontName="SansSerif" size="11" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{clienteNombre}]]></textFieldExpression></textField>
        <textField><reportElement x="10" y="38" width="260" height="14"/><textElement><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["Doc.: " + $P{clienteDocumento}]]></textFieldExpression></textField>
        <staticText><reportElement x="295" y="6" width="200" height="13"/><textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[VEHÍCULO]]></text></staticText>
        <textField><reportElement x="295" y="20" width="250" height="16"/><textElement><font fontName="SansSerif" size="11" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{vehiculoPlaca} + "  " + $P{vehiculoDescripcion}]]></textFieldExpression></textField>
        <textField><reportElement x="10" y="62" width="535" height="16"/><textElement><font fontName="SansSerif" size="10"/></textElement><textFieldExpression><![CDATA["Periodo de alquiler: " + $P{periodo}]]></textFieldExpression></textField>
        <textField><reportElement x="295" y="80" width="250" height="16"/><textElement textAlignment="Right"><font fontName="SansSerif" size="10"/></textElement><textFieldExpression><![CDATA["Contrato No. " + $P{contratoId}]]></textFieldExpression></textField>
      </frame>
    </band>
  </title>
